{
  "name": "@reprodutor/player",
  "productName": "Reprodutor Player",
  "version": "0.1.16",
  "description": "Player de sinalização digital com cache offline",
  "author": "Reprodutor de Mídia",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "node ../../tools/build-app.js",
    "pack": "node ../../tools/build-app.js && electron-builder --win --x64 --dir",
    "dist": "node ../../tools/build-app.js && electron-builder --win --x64"
  },
  "devDependencies": {
    "@reprodutor/shared": "*"
  },
  "build": {
    "appId": "br.reprodutor.player",
    "productName": "Reprodutor Player",
    "electronVersion": "45.2.3",
    "directories": {
      "output": "../../release/player",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js",
      "name": "reprodutor-player"
    },
    "artifactName": "ReprodutorPlayer-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Reprodutor Player"
    }
  }
}
